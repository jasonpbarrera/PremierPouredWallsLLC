@page "/about"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<AboutPageSettings> AboutConfig

<PageTitle>About Scott Barrera | @BusinessConfig.Value.ShortName</PageTitle>

<div class="about-page-wrapper">
    <!-- HERO HEADER -->
    <section class="about-hero-header">
        <div class="content-container">
            <div class="industrial-kicker industrial-kicker-hazard">On-Site Leadership &amp; Engineering</div>
            <h1 class="about-hero-title">MEET SCOTT BARRERA</h1>
            <p class="about-hero-lead">
                Owner, operator, and on-site concrete specialist behind Premier Poured Walls LLC in Cleveland, Tennessee.
            </p>
        </div>
    </section>

    <div class="content-container">
        <!-- FOUNDER SPOTLIGHT CARD -->
        <div class="founder-spotlight-card">
            <div class="founder-badge-column">
                <div class="founder-emblem-box">
                    <img src="images/logo.png" alt="Premier Poured Walls LLC" class="founder-logo" />
                </div>
                <div class="founder-id-box">
                    <h3>SCOTT BARRERA</h3>
                    <span class="founder-role">Owner &amp; Operator</span>
                    <span class="founder-location">📍 Cleveland, TN</span>
                    <a href="tel:@BusinessConfig.Value.PhoneNumber" class="founder-phone-btn">
                        📞 (423) 457-2024
                    </a>
                </div>
            </div>

            <div class="founder-bio-column">
                <div class="industrial-kicker">Hands-On Foundation Contractor</div>
                <h2>"QUALITY AND INTEGRITY IN EVERY POUR."</h2>
                <p>
                    When you hire Premier Poured Walls LLC, you don't get a middleman salesman or an outsourced crew. <strong>Scott Barrera is on the job site personally managing every phase of your project</strong>—from the initial laser-graded footing trench and steel rebar cage placement to the precision erection of steel wall forms and the continuous boom-pump pour.
                </p>
                <p>
                    Based in Cleveland, Tennessee, Scott has built Premier Poured Walls on an uncompromising commitment to structural excellence. Whether navigating the steep hillside grades of Lookout Mountain, pouring complex multi-tier radius retaining walls in Dunlap, or integrating a Fort Knox-grade tornado safe room into a custom residential basement, Scott brings decades of specialized poured concrete expertise to every square foot.
                </p>
                
                <div class="founder-creds-grid">
                    <div class="cred-item">
                        <strong>100% Owner Supervised</strong>
                        <span>Scott is on-site ensuring form alignment, plumb lines, and proper vibration.</span>
                    </div>
                    <div class="cred-item">
                        <strong>Turnkey Execution</strong>
                        <span>From raw site excavation and footing digs to continuous placement and form stripping.</span>
                    </div>
                    <div class="cred-item">
                        <strong>Commercial-Grade Ready Mix</strong>
                        <span>4,000+ PSI concrete with engineered rebar grids built to hold up forever homes.</span>
                    </div>
                    <div class="cred-item">
                        <strong>Regional Terrain Specialists</strong>
                        <span>Experienced in steep mountain cuts, heavy rock conditions, and extreme backfill loads.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ON-SITE CRAFTSMANSHIP SHOWCASE -->
        <div class="craftsmanship-showcase-section">
            <div class="showcase-header">
                <div class="industrial-kicker">Precision Formwork &amp; Pours</div>
                <h2>THE PREMIER DIFFERENCE ON THE JOB SITE</h2>
                <p>
                    See the heavy-duty steel formwork, continuous placement, and finished monolithic structures built by Scott and the Premier crew across Southeast Tennessee.
                </p>
            </div>

            <div class="showcase-dual-cards">
                <div class="showcase-card">
                    <div class="showcase-img-box">
                        <img src="images/projects/project-1.jpg" alt="Poured Concrete Wall Forms by Scott Barrera" loading="lazy" />
                    </div>
                    <div class="showcase-body">
                        <h3>Precision Steel Form Erection</h3>
                        <p>High-capacity steel forms are laser-aligned and heavily braced to withstand massive hydrostatic pressure during continuous concrete pumping, ensuring perfectly plumb, square walls.</p>
                        <span class="showcase-tag">📍 Lookout Mountain, TN</span>
                    </div>
                </div>

                <div class="showcase-card">
                    <div class="showcase-img-box">
                        <img src="images/projects/finished-stone-estate-retaining-wall.jpg" alt="Completed Monolithic Concrete Retaining Wall on Lookout Mountain" loading="lazy" />
                    </div>
                    <div class="showcase-body">
                        <h3>Finished Monolithic Concrete Walls</h3>
                        <p>Stripped, high-density cured concrete wall with integrated drainage weep holes, engineered to stabilize steep hillside terrain while complementing architectural stone homes.</p>
                        <span class="showcase-tag">📍 Lookout Mountain, TN</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CALL TO ACTION -->
        <div class="about-cta-bar">
            <div>
                <h3>DISCUSS YOUR UPCOMING FOUNDATION WITH SCOTT</h3>
                <p>Have blueprints, site plans, or questions about poured concrete basements or tornado safe rooms? Call Scott directly today.</p>
            </div>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="btn btn-primary">Call Scott: (423) 457-2024</a>
                <a href="/contact" class="btn btn-secondary">Submit Project Plans</a>
            </div>
        </div>
    </div>
</div>
