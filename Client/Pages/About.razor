@page "/about"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<AboutPageSettings> AboutConfig

<PageTitle>@AboutConfig.Value.NavTitle | @BusinessConfig.Value.ShortName</PageTitle>

<div class="about-container">
    <div class="intro-section">
        <h1 class="script-heading">@AboutConfig.Value.Heading</h1>
        <h2>@AboutConfig.Value.Subheading</h2>
        <p class="lead-text">@AboutConfig.Value.LeadText</p>
    </div>

    <div class="founder-profile" style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; margin-bottom: 2.5rem; background: #ffffff; padding: 1.5rem 2rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.04); border-left: 5px solid var(--brand-accent);">
        <img src="images/scotty-barrera.jpg" alt="Scott Barrera" style="width: 130px; height: 130px; border-radius: 50%; object-fit: cover; border: 3px solid var(--brand-accent); box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
        <div style="flex: 1; min-width: 250px;">
            <h3 style="color: var(--brand-primary); margin: 0 0 0.25rem 0; font-size: 1.35rem; font-weight: bold;">Scott Barrera</h3>
            <p style="color: var(--brand-accent); font-weight: 600; margin: 0 0 0.5rem 0; font-size: 0.95rem;">Owner & Founder • Premier Poured Walls LLC</p>
            <p style="margin: 0; color: #4b5563; font-size: 0.95rem; line-height: 1.6;">Based in Cleveland, TN and proudly serving Southeast Tennessee and North Georgia. Scott personally manages every project—from initial footing trenching and steel rebar grid setup to high-precision wall forming and the final concrete pour.</p>
        </div>
    </div>

    <div class="family-story-card" style="background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04); margin-bottom: 2.5rem; display: flex; flex-wrap: wrap; border-top: 4px solid var(--brand-primary);">
        <div style="flex: 1 1 350px; max-height: 320px; overflow: hidden;">
            <img src="images/scotty-family.jpg" alt="Scott Barrera Family" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <div style="flex: 1 1 350px; padding: 2rem; display: flex; flex-direction: column; justify-content: center;">
            <span style="color: var(--brand-accent); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Rooted in Southeast Tennessee & North Georgia</span>
            <h3 style="color: var(--brand-primary); font-size: 1.4rem; margin: 0 0 1rem 0;">Quality & Integrity in Every Pour</h3>
            <p style="color: #4b5563; line-height: 1.7; margin: 0 0 1rem 0;">At Premier Poured Walls LLC, we treat every basement, retaining wall, and storm shelter as if it were holding up our own family home. With specialized steel formwork, heavy vibrated consolidation, and laser-guided leveling, we build structures that endure for generations.</p>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; color: var(--brand-primary); font-weight: 600; font-size: 0.95rem;">
                <span>✓ On-Site Owner Leadership</span>
                <span>✓ Monolithic Strength</span>
                <span>✓ Built for Regional Terrain</span>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <div class="card who-i-am">
            <h3>@AboutConfig.Value.WhoIAmTitle</h3>
            <ul>
                @foreach (var item in AboutConfig.Value.WhoIAmBullets)
                {
                    <li>@item</li>
                }
            </ul>
        </div>

        <div class="card why-i-started">
            <h3>@AboutConfig.Value.WhyStartedTitle</h3>
            @foreach (var p in AboutConfig.Value.WhyStartedParagraphs)
            {
                <p>@p</p>
            }
        </div>
    </div>

    <div class="closing-section">
        @if (!string.IsNullOrWhiteSpace(AboutConfig.Value.ClosingQuote))
        {
            <p class="calling-text">"@AboutConfig.Value.ClosingQuote"</p>
        }
        <p>@AboutConfig.Value.ClosingText</p>
        <h4>@AboutConfig.Value.ThankYouNote</h4>

        <div class="core-values">
            @foreach (var val in AboutConfig.Value.CoreValues)
            {
                <span>✦ @val</span>
            }
        </div>
    </div>
</div>
