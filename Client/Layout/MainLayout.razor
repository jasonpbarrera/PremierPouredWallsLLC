@inherits LayoutComponentBase
@using System.Reflection
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<ThemeSettings> ThemeConfig
@inject IOptions<AboutPageSettings> AboutConfig

<div class="page">
    <!-- Top Utility Bar -->
    <div class="top-utility-bar">
        <div class="top-utility-inner">
            <div class="utility-badge-group">
                <span class="utility-badge">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    <span>Cleveland, Chattanooga & North Georgia</span>
                </span>
                <span class="utility-badge utility-badge-accent">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                    <span>Licensed & Insured • Monolithic Poured Specialist</span>
                </span>
            </div>
            <div>
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="utility-call-link">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                    <span>CALL SCOTT: @BusinessConfig.Value.PhoneNumber</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="site-header">
        <div class="navbar">
            <a class="navbar-brand-group" href="/">
                <img src="@BusinessConfig.Value.LogoUrl" alt="@BusinessConfig.Value.ShortName" class="brand-logo-img" />
                <div class="brand-text-block">
                    <span class="brand-title">PREMIER POURED WALLS</span>
                    <span class="brand-subtitle">Quality & Integrity in Every Pour</span>
                </div>
            </a>

            <nav class="main-navigation">
                <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="/services">Services</NavLink>
                <NavLink href="/about">About Scott</NavLink>
                <NavLink href="/contact">Contact</NavLink>
            </nav>

            <div>
                <a href="/contact" class="header-quote-cta">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                    <span>Request Estimate</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Body Content -->
    <main class="main-content">
        @Body
    </main>

    <!-- Heavy Industrial Concrete Footer -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-col">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                    <img src="@BusinessConfig.Value.LogoUrl" alt="@BusinessConfig.Value.ShortName" style="height: 48px; width: auto;" />
                    <div>
                        <h3 style="color: #ffffff; font-family: var(--font-display); font-size: 1.5rem; margin: 0; line-height: 1;">PREMIER POURED WALLS LLC</h3>
                        <span style="color: var(--brand-accent-glow); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;">Cleveland, TN • Southeast TN & North GA</span>
                    </div>
                </div>
                <p>Specializing in solid monolithic poured concrete basement foundations, engineered curved retaining walls, laser-graded footings, and Fort Knox-grade tornado safe rooms built to withstand the elements for generations.</p>
                <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                    @if (!string.IsNullOrWhiteSpace(BusinessConfig.Value.FacebookUrl))
                    {
                        <a href="@BusinessConfig.Value.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook Page" style="display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; background: var(--brand-secondary); border-radius: 4px; color: var(--brand-accent-glow); border: 1px solid var(--brand-border);">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" /></svg>
                        </a>
                    }
                </div>
            </div>

            <div class="footer-col">
                <h4>Capabilities</h4>
                <ul class="footer-links">
                    <li><a href="/services">Poured Basement Walls</a></li>
                    <li><a href="/services">Radius Retaining Walls</a></li>
                    <li><a href="/services">Fort Knox Safe Rooms</a></li>
                    <li><a href="/services">Excavation & Footing Digs</a></li>
                    <li><a href="/services">Commercial Grade Beams</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Navigation</h4>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/services">Services & Specs</a></li>
                    <li><a href="/about">About Scott Barrera</a></li>
                    <li><a href="/contact">Request an Estimate</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Direct Contact</h4>
                <div class="footer-contact-item">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                    <div>
                        <strong style="color: #ffffff; display: block;">Scott Barrera (Owner):</strong>
                        <a href="tel:@BusinessConfig.Value.PhoneNumber">@BusinessConfig.Value.PhoneNumber</a>
                    </div>
                </div>
                <div class="footer-contact-item">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                    <div>
                        <strong style="color: #ffffff; display: block;">Project Inquiries:</strong>
                        <a href="mailto:@BusinessConfig.Value.PrimaryEmail">@BusinessConfig.Value.PrimaryEmail</a>
                    </div>
                </div>
                <div class="footer-contact-item">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    <div>
                        <strong style="color: #ffffff; display: block;">Base of Operations:</strong>
                        <span>Cleveland, TN 37311</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year @BusinessConfig.Value.CompanyName. All rights reserved. Quality and Integrity in Every Pour.</span>
            <span class="jb-footer-credit">
                v@(AppVersion) &middot; @BuildDate &middot; Powered by <a href="https://jbdigitaltechnologies.net" target="_blank" rel="noopener noreferrer">JB Digital Technologies</a>
            </span>
        </div>
    </footer>
</div>

@code {
    private static readonly string AppVersion =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";
    private static readonly string BuildDate =
        typeof(MainLayout).Assembly
            .GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(a => a.Key == "BuildTimestamp")?.Value
        ?? DateTime.UtcNow.ToString("MMM d, yyyy");
}
