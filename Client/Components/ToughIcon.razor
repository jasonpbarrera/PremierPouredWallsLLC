@namespace SmallBusinessSite.Client.Components

@switch (Normalize(Name))
{
    case "poured-wall":
    case "foundation":
    case "basement":
    case "wall":
        <!-- Heavy Monolithic Poured Concrete Wall with Form Ties & Anchor Bolts -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Main solid wall block -->
            <rect x="6" y="10" width="36" height="30" rx="2" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="3" />
            <!-- Vertical formwork joint lines -->
            <line x1="18" y1="10" x2="18" y2="40" stroke="currentColor" stroke-dasharray="2 3" />
            <line x1="30" y1="10" x2="30" y2="40" stroke="currentColor" stroke-dasharray="2 3" />
            <!-- Heavy form-tie cones (steel conical ties) -->
            <circle cx="12" cy="18" r="2" fill="currentColor" />
            <circle cx="24" cy="18" r="2" fill="currentColor" />
            <circle cx="36" cy="18" r="2" fill="currentColor" />
            <circle cx="12" cy="32" r="2" fill="currentColor" />
            <circle cx="24" cy="32" r="2" fill="currentColor" />
            <circle cx="36" cy="32" r="2" fill="currentColor" />
            <!-- Heavy top anchor bolt studs -->
            <line x1="12" y1="6" x2="12" y2="10" stroke-width="3" />
            <line x1="24" y1="6" x2="24" y2="10" stroke-width="3" />
            <line x1="36" y1="6" x2="36" y2="10" stroke-width="3" />
            <!-- Footing line -->
            <line x1="2" y1="40" x2="46" y2="40" stroke-width="4" />
        </svg>
        break;

    case "storm-shelter":
    case "safe-room":
    case "bunker":
    case "fort-knox":
        <!-- Reinforced Fortress Concrete Bunker / Heavy Vault Door -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Thick reinforced outer bunker arch/frame -->
            <path d="M6 42V18L24 6L42 18V42H6Z" fill="currentColor" fill-opacity="0.12" stroke-width="3.5" />
            <!-- Inner heavy vault door -->
            <rect x="15" y="20" width="18" height="22" rx="1.5" stroke-width="2.5" />
            <!-- Heavy central vault locking wheel -->
            <circle cx="24" cy="30" r="4.5" stroke-width="2.5" />
            <line x1="24" y1="23" x2="24" y2="37" stroke-width="2" />
            <line x1="17" y1="30" x2="31" y2="30" stroke-width="2" />
            <!-- Heavy industrial door hinges & locking bolts -->
            <rect x="12" y="24" width="3" height="4" fill="currentColor" />
            <rect x="12" y="34" width="3" height="4" fill="currentColor" />
            <!-- Rebar reinforcement indicators in bunker roof -->
            <line x1="14" y1="13" x2="19" y2="16" stroke-width="1.5" />
            <line x1="34" y1="13" x2="29" y2="16" stroke-width="1.5" />
            <!-- Foundation ground line -->
            <line x1="2" y1="42" x2="46" y2="42" stroke-width="4" />
        </svg>
        break;

    case "retaining-wall":
    case "radius-wall":
    case "curved-wall":
    case "retaining":
        <!-- Curved Structural Retaining Wall Holding Back Earth -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Mountain hillside earth mass -->
            <path d="M4 14C12 14 20 22 28 22C36 22 42 16 46 12V42H4V14Z" fill="currentColor" fill-opacity="0.08" stroke="none" />
            <!-- Stepped curved retaining wall structure -->
            <path d="M8 40C14 40 18 36 22 30C26 24 30 20 40 20" stroke="currentColor" stroke-width="4.5" />
            <path d="M12 44C18 44 22 40 26 34C30 28 34 24 44 24" stroke="currentColor" stroke-width="2.5" stroke-dasharray="3 3" />
            <!-- Heavy earth anchors / tie-back deadmen rods -->
            <line x1="22" y1="30" x2="12" y2="24" stroke-width="2" />
            <circle cx="11" cy="23" r="2" fill="currentColor" />
            <line x1="31" y1="20" x2="25" y2="12" stroke-width="2" />
            <circle cx="24" cy="11" r="2" fill="currentColor" />
            <!-- Masonry relief blocks -->
            <line x1="16" y1="38" x2="17" y2="35" stroke-width="2" />
            <line x1="26" y1="26" x2="27" y2="23" stroke-width="2" />
            <!-- Bedrock base -->
            <line x1="2" y1="44" x2="46" y2="44" stroke-width="4" />
        </svg>
        break;

    case "excavator":
    case "dig":
    case "footings":
    case "footing":
    case "excavation":
        <!-- Heavy Tracked Hydraulic Excavator with Serrated Trenching Bucket -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Heavy caterpillar tracks -->
            <rect x="4" y="34" width="24" height="8" rx="4" fill="currentColor" fill-opacity="0.15" stroke-width="3" />
            <circle cx="9" cy="38" r="2" fill="currentColor" />
            <circle cx="16" cy="38" r="2" fill="currentColor" />
            <circle cx="23" cy="38" r="2" fill="currentColor" />
            <!-- Cab and engine housing -->
            <path d="M8 34V22H20V34H8Z" stroke-width="2.5" />
            <path d="M14 22V25H18" stroke-width="2" />
            <!-- Articulated boom arm -->
            <line x1="18" y1="24" x2="28" y2="12" stroke-width="3.5" />
            <circle cx="28" cy="12" r="2" fill="currentColor" />
            <!-- Dipper stick -->
            <line x1="28" y1="12" x2="38" y2="22" stroke-width="3" />
            <circle cx="38" cy="22" r="1.5" fill="currentColor" />
            <!-- Hydraulic cylinder rod -->
            <line x1="20" y1="20" x2="26" y2="17" stroke-width="1.5" />
            <!-- Serrated excavation bucket cutting into trench -->
            <path d="M38 22L43 27L40 33L35 30L38 22Z" fill="currentColor" fill-opacity="0.2" stroke-width="2.5" />
            <line x1="43" y1="27" x2="45" y2="29" stroke-width="2" />
            <line x1="41.5" y1="30" x2="43.5" y2="32" stroke-width="2" />
            <line x1="40" y1="33" x2="41.5" y2="35.5" stroke-width="2" />
            <!-- Ground trench excavation line -->
            <path d="M28 42H46V36" stroke-width="3" />
        </svg>
        break;

    case "tall-walls":
    case "commercial":
    case "castle":
    case "crane":
        <!-- 16-Foot Steel Formwork Panels with Turnbuckle Wall Braces -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Massive 16ft tall formwork panels -->
            <rect x="14" y="4" width="20" height="38" rx="1.5" fill="currentColor" fill-opacity="0.12" stroke-width="3" />
            <!-- Steel waler ribs / horizontal stiffeners -->
            <line x1="14" y1="12" x2="34" y2="12" stroke-width="2" />
            <line x1="14" y1="20" x2="34" y2="20" stroke-width="2" />
            <line x1="14" y1="28" x2="34" y2="28" stroke-width="2" />
            <line x1="14" y1="36" x2="34" y2="36" stroke-width="2" />
            <!-- Heavy diagonal turnbuckle steel alignment braces -->
            <line x1="34" y1="16" x2="44" y2="42" stroke-width="2.5" />
            <circle cx="39" cy="29" r="1.5" fill="currentColor" />
            <line x1="14" y1="16" x2="4" y2="42" stroke-width="2.5" />
            <circle cx="9" cy="29" r="1.5" fill="currentColor" />
            <!-- Heavy base line / poured footing -->
            <line x1="2" y1="42" x2="46" y2="42" stroke-width="4" />
        </svg>
        break;

    case "waterproofing":
    case "shield":
    case "drainage":
    case "membrane":
        <!-- Diamond-Plated Armor Barrier with Cold-Joint Foundation Seal -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Heavy faceted armor shield -->
            <path d="M24 4L38 9V22C38 32 24 42 24 42C24 42 10 32 10 22V9L24 4Z" fill="currentColor" fill-opacity="0.12" stroke-width="3" />
            <!-- Inner cold-joint barrier seal -->
            <path d="M24 10L32 14V22C32 29 24 35 24 35C24 35 16 29 16 22V14L24 10Z" stroke-width="2" />
            <!-- Heavy industrial bolts on shield face -->
            <circle cx="24" cy="18" r="1.5" fill="currentColor" />
            <circle cx="24" cy="26" r="1.5" fill="currentColor" />
            <circle cx="20" cy="22" r="1.5" fill="currentColor" />
            <circle cx="28" cy="22" r="1.5" fill="currentColor" />
        </svg>
        break;

    case "sledgehammer":
    case "hammer":
    case "demolition":
        <!-- Heavy Construction Sledgehammer & Anvil -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Heavy octagonal sledgehammer head -->
            <path d="M12 10L16 6L32 22L28 26L12 10Z" fill="currentColor" fill-opacity="0.2" stroke-width="3" />
            <!-- Steel knurled handle -->
            <line x1="22" y1="16" x2="40" y2="34" stroke-width="3.5" />
            <!-- Handle grip wraps -->
            <line x1="33" y1="27" x2="36" y2="30" stroke-width="1.5" />
            <line x1="36" y1="30" x2="39" y2="33" stroke-width="1.5" />
            <!-- Heavy anvil base -->
            <path d="M6 38H30L26 44H10L6 38Z" stroke-width="2.5" />
        </svg>
        break;

    case "concrete-mixer":
    case "truck":
    case "mixer":
        <!-- Commercial Concrete Transit Mixer Drum & Discharge Chute -->
        <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Truck cab -->
            <path d="M4 36V22H14L18 28V36H4Z" stroke-width="2.5" />
            <circle cx="8" cy="38" r="3" fill="currentColor" fill-opacity="0.2" stroke-width="2.5" />
            <circle cx="34" cy="38" r="3" fill="currentColor" fill-opacity="0.2" stroke-width="2.5" />
            <circle cx="42" cy="38" r="3" fill="currentColor" fill-opacity="0.2" stroke-width="2.5" />
            <!-- Rotating mixer drum angled upward -->
            <path d="M16 26L32 12L40 22L24 34L16 26Z" fill="currentColor" fill-opacity="0.15" stroke-width="3" />
            <!-- Spiral drum flighting lines -->
            <path d="M22 21C26 24 30 22 34 17" stroke-width="2" />
            <!-- Discharge chute -->
            <line x1="40" y1="22" x2="46" y2="28" stroke-width="3" />
        </svg>
        break;

    default:
        if (!string.IsNullOrWhiteSpace(Name) && Name.Contains("<svg"))
        {
            @((MarkupString)Name)
        }
        else if (!string.IsNullOrWhiteSpace(Name) && Name.Length <= 4)
        {
            <span class="emoji-icon">@Name</span>
        }
        else
        {
            <!-- Default Heavy Concrete Foundation Block -->
            <svg class="@CssClass" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="10" width="36" height="28" rx="2" fill="currentColor" fill-opacity="0.12" stroke-width="3" />
                <line x1="18" y1="10" x2="18" y2="38" stroke-dasharray="2 3" />
                <line x1="30" y1="10" x2="30" y2="38" stroke-dasharray="2 3" />
                <circle cx="12" cy="24" r="2" fill="currentColor" />
                <circle cx="24" cy="24" r="2" fill="currentColor" />
                <circle cx="36" cy="24" r="2" fill="currentColor" />
                <line x1="2" y1="38" x2="46" y2="38" stroke-width="4" />
            </svg>
        }
        break;
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = "w-8 h-8";

    private string Normalize(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var s = input.Trim().ToLowerInvariant();
        if (s.Contains("poured") || s.Contains("foundation") || s.Contains("basement")) return "poured-wall";
        if (s.Contains("shelter") || s.Contains("safe") || s.Contains("bunker") || s.Contains("knox")) return "storm-shelter";
        if (s.Contains("retaining") || s.Contains("radius") || s.Contains("curved")) return "retaining-wall";
        if (s.Contains("excavat") || s.Contains("dig") || s.Contains("footing")) return "excavator";
        if (s.Contains("tall") || s.Contains("castle") || s.Contains("commercial") || s.Contains("crane")) return "tall-walls";
        if (s.Contains("waterproof") || s.Contains("shield") || s.Contains("drain") || s.Contains("membrane")) return "waterproofing";
        if (s.Contains("mixer") || s.Contains("truck")) return "concrete-mixer";
        if (s.Contains("hammer") || s.Contains("sledge")) return "sledgehammer";
        return s;
    }
}
